# ==============================================================================
# Unsheet - Environment Variables Template
# Copy this file to .env.local for local development.
# DO NOT COMMIT REAL API KEYS OR PRODUCTION SECRETS TO VERSION CONTROL!
# ==============================================================================

# LLM Gateway (Optional: used for Natural Language to SQL and specification refinement)
# Supports xAI (Grok) and OpenAI. You can also configure keys in the in-app "AI Settings" modal.
GROK_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
GROK_MODEL=grok-2-mini
OPENAI_MODEL=gpt-4o-mini
# GROK_BASE_URL=https://api.x.ai/v1

# Supabase Persistence (Optional: in-memory store fallback is used when unset)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
