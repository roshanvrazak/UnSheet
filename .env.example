# ==============================================================================
# Unsheet - Environment Variables Template
# Copy this file to .env.local for local development.
# DO NOT COMMIT REAL API KEYS OR PRODUCTION SECRETS TO VERSION CONTROL!
# ==============================================================================

# LLM Gateway (Optional: used for Natural Language to SQL and specification refinement)
# Supports xAI (Grok) and OpenAI. You can also configure keys in the in-app "AI Settings" modal.
GROK_API_KEY=
XAI_API_KEY=
OPENAI_API_KEY=
GROK_MODEL=grok-2-mini
OPENAI_MODEL=gpt-4o-mini
# GROK_BASE_URL=https://api.x.ai/v1

# Supabase Persistence (Optional: demo memory store is used only when URL is unset)
# Sharing requires the server-only service-role key and all migrations. Never expose it as NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI spend protection: production provider calls require Supabase service-role access
# and migration 20261009000000_ai_request_limits.sql. Missing/unavailable quotas reject calls.
# Exact custom HTTPS origins; no wildcards, IP literals, credentials, or alternate ports.
AI_ALLOWED_ORIGINS=
# Set only to a header your ingress overwrites and strips from untrusted requests.
# Unset: anonymous callers share one identity; x-forwarded-for is not trusted by default.
AI_TRUSTED_IP_HEADER=
